<template>
  <div class="page">
    <swiper if="{{ mode === 'list' && groups.length > 0 }}" id="tabs" class="tabs" index="{{ startIndex }}" loop="false" indicator="{{ groups.length > 1 }}" @change="tabChange">
      <div class="group" for="group in groups" tid="id">
        <text class="group-title">{{ group.name }}</text>
        <list class="accounts" if="{{ group.mounted }}">
          <list-item class="row" for="row in group.rows" tid="id" type="row" @touchstart="rowStart" @touchend="rowEnd(row.id)">
            <text class="row-title">{{ row.title }}</text>
            <text class="row-sub">{{ row.sub }}</text>
          </list-item>
          <list-item class="empty" if="{{ group.rows.length === 0 }}" type="empty" @touchstart="rowStart" @touchend="rowEnd('')"><text class="message">Chưa có tài khoản</text></list-item>
          <list-item class="foot" type="foot" @touchstart="rowStart" @touchend="rowEnd('')"></list-item>
        </list>
      </div>
    </swiper>
    <div class="page" if="{{ mode === 'list' && groups.length === 0 }}">
      <text class="app-title boot-title">AuthBand</text>
      <text class="message error-message">Chưa có tài khoản</text>
    </div>
    <div class="page" if="{{ mode === 'boot' }}">
      <div class="bone-title"></div>
      <div class="bone-row bone-1"><div class="bone-a"></div><div class="bone-b"></div></div>
      <div class="bone-row bone-2"><div class="bone-a"></div><div class="bone-b"></div></div>
      <div class="bone-row bone-3"><div class="bone-a"></div><div class="bone-b"></div></div>
      <div class="bone-row bone-4"><div class="bone-a"></div><div class="bone-b"></div></div>
      <div class="bone-row bone-5"><div class="bone-a"></div><div class="bone-b"></div></div>
    </div>
    <div class="page" if="{{ mode === 'error' }}">
      <text class="app-title boot-title">AuthBand</text>
      <text class="message error-message">{{ status }}</text>
    </div>
  </div>
</template>
<script>
import interconnect from '@system.interconnect'
import file from '@system.file'
import crypto from '@system.crypto'
import router from '@system.router'
/* AUTHBAND_RUNTIME */
/* AUTHBAND_FIXTURE */
export default {
  private: {mode:'boot',groups:[],startIndex:0,status:''},
  onInit() {
    this._visible=true;this._dead=false;this._exiting=false;this._ready=false;this._loaded=false;this._generation=0;this._counter=0
    this._idleTimer=null;this._serviceTimer=null;this._backTimer=null;this._mountTimer=null;this._saveTimer=null;this._touchAt=0;this._mountOnLift=false;this._active=0;this._activeID=null;this._savedID=null;this._touch=null;this._pushing=false;this._systemBack=false
    this._shared=this.$app.$def.authband
    this._shared.snapshot=null;this._shared.time=null;this._shared.selected=null
    this.activity();this.open()
  },
  onReady() {this._ready=true;if(this._loaded){this.queueMount(2500,2500);this.queueServices()}},
  open() {
    var page=this
    AuthBand.configureCrypto(crypto)
    this._io=new AuthBand.FileStore(file);this._store=new AuthBand.VaultStore(this._io)
    this._receiver=new AuthBand.SyncReceiver(this._store,false,{
      committed:function(value){page.apply(value,page._shared.time)},
      timeSample:async function(sample){
        var time=new AuthBand.TimeState(),saved=time.applySample(sample),raw=JSON.stringify(saved)
        await page._io.write('clock',raw);if(await page._io.read('clock')!==raw)throw new Error('Clock readback')
        if(!page._dead)page._shared.time=saved
      }
    })
    this._peer=new AuthBand.Peer(this._io,this._receiver,{allowEnrollment:synthetic!==null})
    this.load()
  },
  load() {
    var page=this,token=++this._generation,io=this._io
    Promise.all([this._store.load(),io.read('clock'),io.read('erasing'),io.read('ui').catch(function(){return null})]).then(function(loaded){
      if(page._dead || page._exiting || token!==page._generation)return
      if(loaded[2]!==null)throw new Error('Erase incomplete')
      var snapshot=loaded[0],saved=loaded[1],time=null
      // The public fixture is a JSON string, parsed only when no vault exists.
      if(snapshot===null && synthetic!==null){snapshot=JSON.parse(synthetic);saved=JSON.stringify({offset:0,uncertainty:0,wallMs:Date.now()})}
      if(snapshot===null)snapshot={groups:[],accounts:[]}
      // Damaged clock metadata must mask codes without blocking authenticated repair.
      try {if(saved!==null && saved.length<2048)time=JSON.parse(saved)}catch(e){}
      try {var ui=loaded[3];if(ui && ui.length<512)page._savedID=page._activeID=JSON.parse(ui).activeID||null}catch(e){}
      page.apply(snapshot,time)
    }).catch(function(){if(token===page._generation)page.failure()})
  },
  apply(snapshot,time) {
    if(this._dead || this._exiting)return
    var previous=this._shared.snapshot
    this._shared.snapshot=snapshot;this._shared.time=time
    if(!(previous && snapshot.vaultID && previous.vaultID===snapshot.vaultID && previous.revision===snapshot.revision && this._loaded)) {
      // The first frame mounts the active tab and its neighbours. The swiper
      // index is assigned only together with new groups, never afterwards.
      var pages=AuthBand.groupPages(snapshot),index=0,id=this._activeID
      for(var i=0;i<pages.length;i++)if(pages[i].id===id)index=i
      for(var k=index-1;k<=index+1;k++)if(pages[k])pages[k].mounted=true
      this.stopMount();this._active=index;this._activeID=pages[index]?pages[index].id:null
      this.startIndex=index;this.groups=pages
    }
    if(this.mode!=='list')this.mode='list'
    this._loaded=true
    if(this._ready){this.queueMount(2500,2500);this.queueServices()}
  },
  // Only tabs within two of the active one keep a mounted list (at most five of
  // eight): during a drag the native swiper moves every object it contains, and
  // Xiaomi recommends few swiper children. Lists change only while the finger is
  // up: on the emulator a press that overlapped a re-layout lost its touchend.
  queueMount(delay,quiet) {
    var page=this
    if(!this._visible)return
    this.stopMount()
    this._mountTimer=setTimeout(function(){page._mountTimer=null;page.rebalance(quiet)},delay)
  },
  rebalance(quiet) {
    if(this._dead || this._exiting || !this._visible)return
    this.stopMount()
    if(this._touch && Date.now()-this._touchAt<1500){this._mountOnLift=true;return}
    var still=Date.now()-this._touchAt
    if(quiet && still<quiet){this.queueMount(quiet-still,quiet);return}
    this._mountOnLift=false
    var active=this._active
    this.groups.forEach(function(g,i){var want=Math.abs(i-active)<=2;if(g.mounted!==want)g.mounted=want})
  },
  stopMount() {if(this._mountTimer!==null)clearTimeout(this._mountTimer);this._mountTimer=null},
  // Native swiper change, after its animation. Only plain fields change here:
  // no reactive data, no file IO.
  tabChange(event) {
    if(!event || !Number.isInteger(event.index) || !this.groups[event.index] || this._dead || this._exiting)return
    this._active=event.index;this._activeID=this.groups[event.index].id
    this.activity()
    this.queueMount(300,300)
    this.queueSave(2500)
  },
  // The active tab is written after 2.5s without touches (or on hide), so no
  // file IO happens during a swipe and exit never has to write.
  queueSave(delay) {
    var page=this
    if(this._saveTimer!==null)clearTimeout(this._saveTimer)
    this._saveTimer=setTimeout(function(){
      page._saveTimer=null
      if(page._dead || page._exiting || !page._visible)return
      var quiet=Date.now()-page._touchAt
      if(page._touch || quiet<2500){page.queueSave(Math.max(300,2500-quiet));return}
      page.savePreferences()
    },delay)
  },
  savePreferences() {
    if(!this._io || !this._activeID || this._activeID===this._savedID)return
    this._savedID=this._activeID
    this._io.write('ui',JSON.stringify({activeID:this._activeID})).catch(function(){})
  },
  failure() {if(!this._dead && !this._exiting){this._shared.snapshot=null;this.mode='error';this.status='Không đọc được kho. Cần khôi phục.'}},
  // Interconnect is not on the first-frame path.
  queueServices() {
    var page=this
    if(this._connection || this._serviceTimer!==null || !this._visible)return
    this._serviceTimer=setTimeout(function(){page._serviceTimer=null;page.startServices()},300)
  },
  startServices() {
    var page=this
    if(this._dead || this._exiting || !this._visible || this._connection)return
    try {
      this._connection=interconnect.instance()
      this._connection.onmessage=function(event){page.receive(event)}
      this._connection.onclose=function(){page._peer.close()}
      this._connection.onerror=function(){page._peer.close()}
      this._connection.onopen=function(){}
    } catch(e) {this._connection=null}
  },
  detachConnection() {
    var connection=this._connection;if(!connection)return
    connection.onmessage=null;connection.onopen=null;connection.onclose=null;connection.onerror=null
  },
  // Rows decide tap versus swipe themselves: the native list delivered a
  // horizontal drag across a row as a click.
  rowStart(event) {
    var point=event && event.touches && event.touches[0]
    this._touch=point?{x:point.clientX,y:point.clientY}:null
    this._touchAt=Date.now()
  },
  rowEnd(id,event) {
    var start=this._touch,point=event && event.changedTouches && event.changedTouches[0];this._touch=null
    this._touchAt=Date.now()
    if(!start || !point)return
    var dx=point.clientX-start.x,dy=point.clientY-start.y
    this.activity()
    if(Math.abs(dx)<14 && Math.abs(dy)<14)this.openCode(id)
    else if(this._active===0 && dx>=60 && dx>Math.abs(dy)*1.5)this.backGesture()
    else if(this._mountOnLift)this.rebalance(0)
  },
  openCode(id) {
    var snapshot=this._shared.snapshot
    if(!this._visible || this._pushing || this.mode!=='list' || !snapshot)return
    if(!snapshot.accounts.some(function(a){return a.id===id}))return
    this._shared.selected=id;this._pushing=true
    router.push({uri:'pages/code'})
  },
  // On the first tab a right swipe is the system back, which exits with the
  // firmware's own transition. This is only a fallback for runtimes that do not
  // deliver it; it waits briefly so a system back for the same swipe wins.
  backGesture() {
    var page=this
    if(this._backTimer!==null)clearTimeout(this._backTimer)
    this._backTimer=setTimeout(function(){
      page._backTimer=null
      if(page._visible && !page._systemBack && !page._exiting)page.leave()
    },200)
  },
  onBackPress() {
    if(this._active>0 && this.mode==='list'){
      var tabs=this.$element('tabs');if(tabs)tabs.swipeTo({index:this._active-1})
      return true
    }
    this._systemBack=true;this.savePreferences();this.release()
    return false
  },
  onShow() {
    this._pushing=false
    if(this._dead || this._exiting || this._visible)return
    this._visible=true
    if(Date.now()>=this._shared.idleDeadline){this.exit();return}
    this.armIdle(this._shared.idleDeadline-Date.now())
    if(!this._loaded)this.load()
    else if(this._ready){this.queueMount(2500,2500);this.queueServices()}
  },
  onHide() {
    if(!this._visible)return
    this._visible=false;this._touch=null
    this.stopIdle();this.stopTimers()
    // Preferences are written only when the page goes away, never during a swipe.
    if(!this._exiting)this.savePreferences()
    try {if(this._peer)this._peer.close()}catch(e){}
  },
  onDestroy() {
    this._dead=true;this._visible=false
    this.release()
    this._shared.snapshot=null;this._shared.time=null;this._shared.selected=null
  },
  stopTimers() {
    this.stopMount()
    if(this._saveTimer!==null)clearTimeout(this._saveTimer);this._saveTimer=null
    if(this._serviceTimer!==null)clearTimeout(this._serviceTimer);this._serviceTimer=null
    if(this._backTimer!==null)clearTimeout(this._backTimer);this._backTimer=null
  },
  // Stops all work without rendering. Used before any kind of exit.
  release() {
    this._exiting=true
    this.stopIdle();this.stopTimers();this._touch=null
    try {this.detachConnection();if(this._peer)this._peer.close()}catch(e){}
  },
  // Leaves through the router like the system back does, so the firmware runs
  // its normal back/exit path instead of an immediate process exit.
  leave() {
    if(this._exiting)return
    this.savePreferences();this.release()
    router.back()
  },
  exit() {
    if(this._exiting && this._exitRequested)return
    // Remember the tab the app was left on; exit waits briefly for this write.
    this._exitRequested=true;this.savePreferences();this.release()
    var page=this,done=false,finish=function(){if(done)return;done=true;page.$app.exit()}
    if(this._io && this._io.pending>0){this._io.idle(finish);setTimeout(finish,400)}
    else finish()
  },
  activity() {
    if(this._dead || this._exiting)return
    this._shared.idleDeadline=Date.now()+300000
    if(this._idleTimer===null && this._visible)this.armIdle(300000)
  },
  armIdle(delay) {
    this.stopIdle()
    var page=this,id=setTimeout(function(){
      if(page._idleTimer!==id)return
      page._idleTimer=null
      var remaining=page._shared.idleDeadline-Date.now()
      if(remaining>0){page.armIdle(remaining);return}
      page.exit()
    },delay)
    this._idleTimer=id
  },
  stopIdle() {if(this._idleTimer!==null)clearTimeout(this._idleTimer);this._idleTimer=null},
  async receive(event) {
    if(!this._visible || this._dead || this._exiting)return
    try {
      var message=event && event.data!==undefined?event.data:event
      if(typeof message==='string'){if(AuthBand.utf8(message).length>512)return;message=JSON.parse(message)}
      if(!message || message.type==='ack')return
      var result=await this._peer.receive(message)
      if(!this._visible || this._dead)return
      this.send({v:1,id:message.id,src:'band',type:'ack'})
      this._counter=(this._counter+1)%1000000
      this.send({v:1,id:'b-'+this._counter,src:'band',type:'message',topic:result.topic,body:result.body})
    }catch(e){}
  },
  send(envelope) {if(this._connection && AuthBand.utf8(JSON.stringify(envelope)).length<=512)this._connection.send({data:envelope})}
}
</script>
<style>
.page {width:212px;height:520px;background-color:#000000;}
.tabs {width:212px;height:520px;indicator-color:#3a3c40;indicator-selected-color:#82e8be;indicator-size:7px;indicator-bottom:34px;}
.group {width:212px;height:520px;}
.group-title {position:absolute;left:30px;top:24px;width:152px;height:40px;line-height:36px;font-size:25px;color:#ffffff;text-align:center;lines:1;text-overflow:ellipsis;}
.accounts {position:absolute;left:0px;top:72px;width:212px;height:400px;}
.row {width:212px;height:66px;padding-left:18px;padding-right:16px;padding-top:6px;flex-direction:column;}
.row-title {width:178px;height:31px;line-height:30px;font-size:24px;color:#ffffff;lines:1;text-overflow:ellipsis;}
.row-sub {width:178px;height:24px;line-height:22px;font-size:18px;color:#8e9196;lines:1;text-overflow:ellipsis;}
.empty {width:212px;height:200px;align-items:center;justify-content:center;}
/* Keeps every list scrollable: a drag on a list that fits was delivered as a tap. */
.foot {width:212px;height:56px;}
.message {width:176px;height:100px;font-size:20px;color:#8e9196;text-align:center;lines:4;}
.app-title {width:212px;height:30px;line-height:28px;font-size:19px;color:#8e9196;text-align:center;lines:1;}
.boot-title {position:absolute;left:0px;top:26px;}
.error-message {position:absolute;left:18px;top:110px;}
.bone-title {position:absolute;left:61px;top:36px;width:90px;height:16px;border-radius:8px;background-color:#1d1e21;}
.bone-row {position:absolute;left:18px;width:178px;height:56px;flex-direction:column;}
.bone-1 {top:80px;}
.bone-2 {top:146px;}
.bone-3 {top:212px;}
.bone-4 {top:278px;}
.bone-5 {top:344px;}
.bone-a {width:120px;height:18px;margin-top:6px;border-radius:9px;background-color:#1d1e21;}
.bone-b {width:84px;height:12px;margin-top:10px;border-radius:6px;background-color:#16171a;}
</style>
